# Skinny Legend web — copy to .env.local for local dev, or add in Vercel → Project → Settings → Environment Variables.
# Server-only: none of these are ever sent to the browser. Never commit real keys.

# Option A (preferred): xAI Grok vision
XAI_API_KEY=
# Vision-capable Grok model (default: grok-4.7)
NUTRITION_MODEL=grok-4.7
# Optional: reasoning effort for xAI (low | medium | high). Default: low (faster).
NUTRITION_REASONING_EFFORT=low

# Option B: OpenAI (used only if XAI_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_NUTRITION_MODEL=gpt-4o-mini

# With no key set, /api/analyze returns clearly labeled MOCK data and the UI shows a "Demo mode" badge.

# Legend Chat (/chat): restaurants near you from the Yelp Places (Fusion) API.
# Get a key at https://www.yelp.com/developers (create an app → API Key). Server-only.
# Without it, /api/chat returns clearly labeled MOCK demo restaurants.
YELP_API_KEY=
# Optional: model for Legend Chat (defaults to NUTRITION_MODEL). Uses XAI_API_KEY (or OPENAI_API_KEY).
# Without an AI key, picks are rule-based and labeled MOCK.
CHAT_MODEL=
# Optional: reasoning effort for chat (low | medium | high). Default: NUTRITION_REASONING_EFFORT or low.
CHAT_REASONING_EFFORT=
